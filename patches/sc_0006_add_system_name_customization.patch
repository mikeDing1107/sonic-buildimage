From 8227c3b45dbbb859fb2d5286ed3ff34708969fbc Mon Sep 17 00:00:00 2001
From: joshjiang113 <josh_jiang@sdc.sercomm.com>
Date: Fri, 26 Jun 2026 07:00:08 +0000
Subject: [PATCH] System name customization

---
 sonic-chassisd/scripts/chassis_db_init | 24 +++++++++++++++++++++---
 1 file changed, 21 insertions(+), 3 deletions(-)

diff --git a/sonic-chassisd/scripts/chassis_db_init b/sonic-chassisd/scripts/chassis_db_init
index b1aafb8..dcc7b3b 100644
--- a/sonic-chassisd/scripts/chassis_db_init
+++ b/sonic-chassisd/scripts/chassis_db_init
@@ -66,16 +66,34 @@ def try_get(callback, *args, **kwargs):
 # Functions
 # 
 
+SERIAL_FILE = "/host/product/mac"
+MODEL_FILE = "/host/product/model_name"
+REVISION_FILE = "/host/product/hw_version"
+
+def _read_value_from_file(file_path):
+    if os.path.exists(file_path):
+        try:
+            with open(file_path, 'r') as f:
+                return f.read().strip()
+        except Exception as e:
+            return None
+        
+    return None
+
 def provision_db(platform_chassis, log):
     # Init state db connection
     state_db = daemon_base.db_connect("STATE_DB")
     chassis_table = swsscommon.Table(state_db, CHASSIS_INFO_TABLE)
 
+    serial = _read_value_from_file(SERIAL_FILE) or try_get(platform_chassis.get_serial)
+    model = _read_value_from_file(MODEL_FILE) or try_get(platform_chassis.get_model)
+    revision = _read_value_from_file(REVISION_FILE) or try_get(platform_chassis.get_revision)
+
     # Populate DB with chassis hardware info 
     fvs = swsscommon.FieldValuePairs([
-                                        (CHASSIS_INFO_SERIAL_FIELD, try_get(platform_chassis.get_serial)),
-                                        (CHASSIS_INFO_MODEL_FIELD, try_get(platform_chassis.get_model)),
-                                        (CHASSIS_INFO_REV_FIELD, try_get(platform_chassis.get_revision))
+                                        (CHASSIS_INFO_SERIAL_FIELD, serial),
+                                        (CHASSIS_INFO_MODEL_FIELD, model),
+                                        (CHASSIS_INFO_REV_FIELD, revision)
                                     ])
     chassis_table.set(CHASSIS_INFO_KEY_TEMPLATE.format(1), fvs)
     log.log_info("STATE_DB provisioned with chassis info.")
-- 

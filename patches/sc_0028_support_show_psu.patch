diff --git a/rd98dx45xx_cn9131/sonic_platform/psu.py b/rd98dx45xx_cn9131/sonic_platform/psu.py
new file mode 100644
index 0000000..55af3f5
--- /dev/null
+++ b/rd98dx45xx_cn9131/sonic_platform/psu.py
@@ -0,0 +1,220 @@
+import os
+import re
+import time
+import subprocess
+from sonic_platform_base.psu_base import PsuBase
+
+class Psu(PsuBase):
+    """
+    SONiC Platform API 2.0 adapter for INA700 current sensor based PSU monitoring.
+    Wraps the legacy /etc/sercomm/current-sensor script into standard Platform API.
+    """
+
+    SENSOR_SCRIPT = "/etc/sercomm/current-sensor"
+    CACHE_TTL_SECS = 2  # Cache Time-To-Live in seconds (must be < psud poll interval of 3s)
+
+    # Threshold constants
+    VOLTAGE_HIGH_THRESHOLD = 13.2
+    VOLTAGE_LOW_THRESHOLD = 10.8
+    TEMPERATURE_HIGH_THRESHOLD = 60.0
+    MAX_SUPPLIED_POWER = 120.0
+
+    STATUS_LED_COLOR_GREEN = "green"
+    STATUS_LED_COLOR_RED = "red"
+    STATUS_LED_COLOR_OFF = "off"
+
+    def __init__(self, psu_index=0):
+        super().__init__()
+        self.index = psu_index
+        self._data_cache = {}
+        self._cache_timestamp = 0
+        # Do not call _update_cache() here. Defer to first access to avoid 
+        # initialization failures if I2C/sensors are not ready at boot.
+
+    def _ensure_cache_fresh(self):
+        """
+        Check if the cache is expired. If so, re-run the sensor script to update it.
+        This is the core fix for the 'PSU absence' bug where psud polls every 3 seconds
+        but the cache was only populated once during __init__.
+        """
+        now = time.monotonic()
+        if (now - self._cache_timestamp) >= self.CACHE_TTL_SECS:
+            self._update_cache()
+            self._cache_timestamp = now
+
+    def _update_cache(self):
+        """
+        Execute the sensor script and parse its output into the data cache.
+        """
+        try:
+            result = subprocess.run(
+                [self.SENSOR_SCRIPT],
+                capture_output=True,
+                text=True,
+                timeout=5
+            )
+            if result.returncode != 0 or "Power monitor OK" not in result.stdout:
+                self._data_cache = {}
+                return
+
+            cache = {}
+            for line in result.stdout.strip().split('\n'):
+                line = line.strip()
+                if '=' not in line:
+                    continue
+                key_part, value_part = line.split('=', 1)
+                key = key_part.strip().lower().replace(' ', '_')
+                num_match = re.match(r'^\s*([-\d.]+)', value_part)
+                if num_match:
+                    cache[key] = float(num_match.group(1))
+            self._data_cache = cache
+        except Exception as e:
+            self._data_cache = {}
+
+    def get_name(self):
+        """
+        Retrieves the name of the PSU.
+        """
+        return "PSU {}".format(self.index + 1)
+
+    def get_presence(self):
+        """
+        Retrieves the presence of the PSU.
+        Returns True if valid sensor data can be read.
+        """
+        self._ensure_cache_fresh()
+        return bool(self._data_cache)
+
+    def get_powergood_status(self):
+        """
+        Retrieves the power status of the PSU.
+        Returns True if bus voltage is within acceptable range.
+        """
+        self._ensure_cache_fresh()
+        voltage = self._data_cache.get('bus_voltage', 0)
+        return self.VOLTAGE_LOW_THRESHOLD <= voltage <= self.VOLTAGE_HIGH_THRESHOLD
+
+    def get_voltage(self):
+        """
+        Retrieves output supply voltage of the PSU.
+        """
+        self._ensure_cache_fresh()
+        return self._data_cache.get('bus_voltage', None)
+
+    def get_current(self):
+        """
+        Retrieves present electric current supplied by the PSU.
+        """
+        self._ensure_cache_fresh()
+        return self._data_cache.get('current', None)
+
+    def get_power(self):
+        """
+        Retrieves current energy supplied by the PSU.
+        """
+        self._ensure_cache_fresh()
+        return self._data_cache.get('power', None)
+
+    def get_temperature(self):
+        """
+        Retrieves current temperature reading from the PSU.
+        """
+        self._ensure_cache_fresh()
+        return self._data_cache.get('temperature', None)
+
+    def get_temperature_high_threshold(self):
+        """
+        Retrieves the high threshold PSU temperature.
+        """
+        return self.TEMPERATURE_HIGH_THRESHOLD
+
+    def get_voltage_high_threshold(self):
+        """
+        Retrieves the high threshold PSU voltage.
+        """
+        return self.VOLTAGE_HIGH_THRESHOLD
+
+    def get_voltage_low_threshold(self):
+        """
+        Retrieves the low threshold PSU voltage.
+        """
+        return self.VOLTAGE_LOW_THRESHOLD
+
+    def get_input_voltage(self):
+        """
+        Retrieves input voltage. Assuming same as bus voltage for this sensor.
+        """
+        self._ensure_cache_fresh()
+        return self._data_cache.get('bus_voltage', None)
+
+    def get_input_current(self):
+        """
+        Retrieves input current. Assuming same as current for this sensor.
+        """
+        self._ensure_cache_fresh()
+        return self._data_cache.get('current', None)
+
+    def get_maximum_supplied_power(self):
+        """
+        Retrieves the maximum power (in Watts) that the PSU can supply.
+        """
+        return self.MAX_SUPPLIED_POWER
+
+    def get_model(self):
+        """
+        Retrieves the model number (or part number) of the PSU.
+        """
+        return "INA700-PSU"
+
+    def get_serial(self):
+        """
+        Retrieves the serial number of the PSU.
+        """
+        return "N/A"
+
+    def get_revision(self):
+        """
+        Retrieves the hardware revision of the PSU.
+        """
+        return "N/A"
+
+    def is_replaceable(self):
+        """
+        Return whether this device is replaceable.
+        """
+        return False
+
+    def get_position_in_parent(self):
+        """
+        Retrieves 1-based relative physical position in parent device.
+        """
+        return self.index + 1
+
+    def get_status_led(self):
+        """
+        Gets the state of the PSU status LED.
+        """
+        if self.get_presence() and self.get_powergood_status():
+            return self.STATUS_LED_COLOR_GREEN
+        return self.STATUS_LED_COLOR_RED
+
+    def set_status_led(self, color):
+        """
+        Sets the state of the PSU status LED.
+        No physical LED control via this sensor; just return True.
+        """
+        return True
+
+    def get_psu_power_critical_threshold(self):
+        """
+        Retrieves the critical power threshold of the PSU.
+        Return None to disable psud power threshold checks.
+        """
+        return None
+
+    def get_psu_power_warning_suppress_threshold(self):
+        """
+        Retrieves the warning suppress power threshold of the PSU.
+        Return None to disable psud power threshold checks.
+        """
+        return None

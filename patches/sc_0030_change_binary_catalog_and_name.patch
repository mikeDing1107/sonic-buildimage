From 565f512dc1b5cc27c4044d9878c74295268eb6a5 Mon Sep 17 00:00:00 2001
From: joshjiang113 <josh_jiang@sdc.sercomm.com>
Date: Thu, 24 Sep 2026 05:46:14 +0000
Subject: [PATCH] change binary catalog and name

---
 rd98dx45xx_cn9131/sonic_platform/chassis.py | 4 ++--
 rd98dx45xx_cn9131/sonic_platform/psu.py     | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/rd98dx45xx_cn9131/sonic_platform/chassis.py b/rd98dx45xx_cn9131/sonic_platform/chassis.py
index 151f650..5ba2ac4 100644
--- a/rd98dx45xx_cn9131/sonic_platform/chassis.py
+++ b/rd98dx45xx_cn9131/sonic_platform/chassis.py
@@ -37,7 +37,7 @@ SYSLOG_IDENTIFIER = "chassis"
 sonic_logger = logger.Logger(SYSLOG_IDENTIFIER)
 
 # Fan configuration
-FAN_SCRIPT_PATH = '/etc/sercomm/fan'
+FAN_SCRIPT_PATH = '/usr/local/bin/sc_fan'
 NUM_FANS = 3
 
 class Fan(FanBase): 
@@ -49,7 +49,7 @@ class Fan(FanBase):
         self.fan_id = fan_index + 1
 
     def get_speed(self):
-        """Get fan speed percentage by calling /etc/sercomm/fan script."""
+        """Get fan speed percentage by calling /usr/local/bin/sc_fan script."""
         try:
             result = subprocess.run(
                 [FAN_SCRIPT_PATH],
diff --git a/rd98dx45xx_cn9131/sonic_platform/psu.py b/rd98dx45xx_cn9131/sonic_platform/psu.py
index 6dc2550..6a0e04a 100644
--- a/rd98dx45xx_cn9131/sonic_platform/psu.py
+++ b/rd98dx45xx_cn9131/sonic_platform/psu.py
@@ -7,10 +7,10 @@ from sonic_platform_base.psu_base import PsuBase
 class Psu(PsuBase):
     """
     SONiC Platform API 2.0 adapter for INA700 current sensor based PSU monitoring.
-    Wraps the legacy /etc/sercomm/current-sensor script into standard Platform API.
+    Wraps the legacy /usr/local/bin/sc_psu script into standard Platform API.
     """
 
-    SENSOR_SCRIPT = "/etc/sercomm/current-sensor"
+    SENSOR_SCRIPT = "/usr/local/bin/sc_psu"
     CACHE_TTL_SECS = 2  # Cache Time-To-Live in seconds (must be < psud poll interval of 3s)
 
     # Threshold constants
-- 
2.25.1


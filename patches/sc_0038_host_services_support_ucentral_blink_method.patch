index 0000000..a7e3659
--- /dev/null
+++ b/host_modules/gnoi_led.py
@@ -0,0 +1,123 @@
+"""gNOI LED control module."""
+
+import json
+import logging
+import os
+import signal
+import subprocess
+import threading
+from host_modules import host_service
+
+MOD_NAME = "gnoi_led"
+logger = logging.getLogger(__name__)
+
+VALID_MODES = {"flash", "stable"}
+VALID_COLORS = {"red", "blue", "green", "yellow"}
+FLASH_DURATION_SEC = 30
+
+
+class GnoiLed(host_service.HostModule):
+    """DBus endpoint for LED control operations."""
+
+    def __init__(self, mod_name):
+        super(GnoiLed, self).__init__(mod_name)
+        self._restore_timer = None
+        self._lock = threading.Lock()
+
+    @host_service.method(
+        host_service.bus_name(MOD_NAME), in_signature="s", out_signature="is"
+    )
+    def flash_led(self, req_str) -> tuple[int, str]:
+        """Flash/control an LED via /usr/local/bin/sc_led."""
+        logger.info("[%s]: Received Flash request: %s", MOD_NAME, req_str)
+        try:
+            req = json.loads(req_str)
+            raw_led_id = req.get("ledId") or req.get("led_id")
+            if raw_led_id is None:
+                raise ValueError(f"Missing led_id. Received keys: {list(req.keys())}")
+            led_id = str(int(raw_led_id))
+            color = str(req.get("color", "")).lower()
+            mode = str(req.get("mode", "")).lower()
+
+            if not led_id.isdigit():
+                raise ValueError(f"Invalid led_id: {led_id}")
+            if color not in VALID_COLORS:
+                raise ValueError(
+                    f"Invalid color: '{color}', allowed: {sorted(VALID_COLORS)}"
+                )
+            if mode not in VALID_MODES:
+                raise ValueError(
+                    f"Invalid mode: '{mode}', allowed: {sorted(VALID_MODES)}"
+                )
+
+            cmd = ["/usr/local/bin/sc_led", led_id, color, mode]
+            logger.info("[%s]: Executing: %s", MOD_NAME, " ".join(cmd))
+
+            env = os.environ.copy()
+            env["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
+            if "DBUS_SYSTEM_BUS_ADDRESS" not in env:
+                env["DBUS_SYSTEM_BUS_ADDRESS"] = "unix:path=/run/dbus/system_bus_socket"
+
+            log_file = "/tmp/sc_led_debug.log"
+            with open(log_file, "a") as f:
+                f.write(f"\n=== CMD: {' '.join(cmd)} ===\n")
+                f.flush()
+
+                proc = subprocess.Popen(
+                    cmd,
+                    stdout=f,
+                    stderr=subprocess.STDOUT,
+                    env=env,
+                    preexec_fn=os.setsid,
+                )
+
+            try:
+                proc.wait(timeout=2)
+            except subprocess.TimeoutExpired:
+                logger.warning("[%s]: sc_led did not exit within 2s, killing", MOD_NAME)
+                proc.kill()
+                proc.wait()
+
+            if mode == "flash":
+                with self._lock:
+                    if self._restore_timer is not None:
+                        self._restore_timer.cancel()
+
+                    restore_cmd = ["/usr/local/bin/sc_led", led_id, "green", "stable"]
+                    logger.info("[%s]: Scheduling restore in %ds: %s",
+                                MOD_NAME, FLASH_DURATION_SEC, " ".join(restore_cmd))
+                    
+                    restore_env = env.copy()
+                    def _do_restore():
+                        logger.info("[%s]: Restoring LED %s to green stable", MOD_NAME, led_id)
+                        with open(log_file, "a") as rf:
+                            rf.write(f"\n=== RESTORE CMD: {' '.join(restore_cmd)} ===\n")
+                            rf.flush()
+                            rproc = subprocess.Popen(
+                                restore_cmd, stdout=rf, stderr=subprocess.STDOUT,
+                                env=restore_env, preexec_fn=os.setsid,
+                            )
+                        try:
+                            rproc.wait(timeout=2)
+                        except subprocess.TimeoutExpired:
+                            logger.warning("[%s]: restore sc_led did not exit within 2s, killing", MOD_NAME)
+                            rproc.kill()
+                            rproc.wait()
+                        with self._lock:
+                            self._restore_timer = None
+
+                    self._restore_timer = threading.Timer(FLASH_DURATION_SEC, _do_restore)
+                    self._restore_timer.daemon = True
+                    self._restore_timer.start()
+
+            return 0, json.dumps({"success": True, "message": "accepted"})
+
+        except Exception as e:
+            msg = f"Exception during LED control: {e}"
+            logger.error("[%s]: %s", MOD_NAME, msg)
+            return -1, json.dumps({"success": False, "message": msg})
+
+
+def register():
+    """Return the class name."""
+    return GnoiLed, MOD_NAME
\ No newline at end of file

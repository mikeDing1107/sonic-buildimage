From db039f41097ff161fb4c319d4aa6b5e65be10337 Mon Sep 17 00:00:00 2001
From: Mike <mike@sercomm.com>
Date: Thu, 17 Sep 2026 13:14:24 +0800
Subject: [PATCH] stpmgrd: align STP IPC structures with sonic-stp stp_ipc.h

---
 cfgmgr/stpmgr.cpp | 3 +++
 cfgmgr/stpmgr.h   | 9 +++++++++
 2 files changed, 12 insertions(+)

diff --git a/cfgmgr/stpmgr.cpp b/cfgmgr/stpmgr.cpp
index d3b75e5..4e34e66 100644
--- a/cfgmgr/stpmgr.cpp
+++ b/cfgmgr/stpmgr.cpp
@@ -927,6 +927,9 @@ int StpMgr::sendMsgStpd(STP_MSG_TYPE msgType, uint32_t msgLen, void *data)
 
     tx_msg->msg_type = msgType;
     tx_msg->msg_len  = msgLen;
+    /* stpd parses this header, it must mirror stp_ipc.h: the 3rd field is the
+       protocol mode, followed by the payload. */
+    tx_msg->proto_mode = l2ProtoEnabled;
     memcpy(tx_msg->data, data, msgLen);
 
     bzero(&addr, sizeof(addr));
diff --git a/cfgmgr/stpmgr.h b/cfgmgr/stpmgr.h
index ca66067..d4c532d 100644
--- a/cfgmgr/stpmgr.h
+++ b/cfgmgr/stpmgr.h
@@ -49,6 +49,7 @@
 typedef enum L2_PROTO_MODE {
     L2_NONE,
     L2_PVSTP,
+    L2_MSTP,
 } L2_PROTO_MODE;
 
 typedef enum STP_MSG_TYPE {
@@ -60,6 +61,10 @@ typedef enum STP_MSG_TYPE {
     STP_PORT_CONFIG,
     STP_VLAN_MEM_CONFIG,
     STP_STPCTL_MSG,
+    STP_MST_GLOBAL_CONFIG,
+    STP_MST_INST_CONFIG,
+    STP_MST_VLAN_PORT_LIST_CONFIG,
+    STP_MST_INST_PORT_CONFIG,
     STP_MAX_MSG
 } STP_MSG_TYPE;
 
@@ -79,6 +84,8 @@ typedef enum STP_CTL_TYPE {
     STP_CTL_CLEAR_VLAN,
     STP_CTL_CLEAR_INTF,
     STP_CTL_CLEAR_VLAN_INTF,
+    STP_CTL_DUMP_MST,
+    STP_CTL_DUMP_MST_PORT,
     STP_CTL_MAX
 } STP_CTL_TYPE;
 
@@ -86,6 +93,7 @@ typedef enum STP_CTL_TYPE {
 typedef struct STP_IPC_MSG {
     int          msg_type;
     unsigned int msg_len;
+    L2_PROTO_MODE proto_mode;
     char         data[0];
 } ALIGNED(4) STP_IPC_MSG;
 
@@ -159,6 +167,7 @@ typedef struct STP_PORT_CONFIG_MSG {
     uint8_t bpdu_guard_do_disable;
     uint8_t portfast;
     uint8_t uplink_fast;
+    int      edge;
     // Add 2 bytes padding for alignment
     uint16_t padding;
     int      path_cost;
-- 
2.34.1


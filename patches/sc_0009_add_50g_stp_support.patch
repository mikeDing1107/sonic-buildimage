From 47409baacdca9ff630dc0f1f29a71e5a118955ed Mon Sep 17 00:00:00 2001
From: Mike_Ding <mike_ding@sercomm.com>
Date: Thu, 20 Aug 2026 15:21:30 +0000
Subject: [PATCH] add 50G port speed support in STP path cost

---
 include/stp.h      | 4 +++-
 include/stp_intf.h | 1 +
 stp/stp_util.c     | 3 +++
 3 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/include/stp.h b/include/stp.h
index 5fab41a..1fba245 100755
--- a/include/stp.h
+++ b/include/stp.h
@@ -50,6 +50,7 @@
 #define STP_LEGACY_PORT_PATH_COST_10G 2
 #define STP_LEGACY_PORT_PATH_COST_25G 1
 #define STP_LEGACY_PORT_PATH_COST_40G 1
+#define STP_LEGACY_PORT_PATH_COST_50G 1
 #define STP_LEGACY_PORT_PATH_COST_100G 1
 #define STP_LEGACY_PORT_PATH_COST_400G 1
 
@@ -63,6 +64,7 @@
 #define STP_PORT_PATH_COST_10G 2000
 #define STP_PORT_PATH_COST_25G 800
 #define STP_PORT_PATH_COST_40G 500
+#define STP_PORT_PATH_COST_50G 400
 #define STP_PORT_PATH_COST_100G 200
 #define STP_PORT_PATH_COST_400G 50
 #define STP_PORT_PATH_COST_1T 20
@@ -396,4 +398,4 @@ typedef enum
 	STP_RAS_TCM_DETECTED
 } STP_RAS_EVENTS;
 
-#endif //__STP_H__
\ No newline at end of file
+#endif //__STP_H__
diff --git a/include/stp_intf.h b/include/stp_intf.h
index a6f76d9..9939036 100755
--- a/include/stp_intf.h
+++ b/include/stp_intf.h
@@ -121,6 +121,7 @@ typedef enum STP_PORT_SPEED
     STP_SPEED_10G   = 10000,
     STP_SPEED_25G   = 25000,
     STP_SPEED_40G   = 40000,
+    STP_SPEED_50G   = 50000,
     STP_SPEED_100G  = 100000,
     STP_SPEED_400G  = 400000,
     STP_SPEED_1T    = 1000000,
diff --git a/stp/stp_util.c b/stp/stp_util.c
index fc02544..dfe5b13 100755
--- a/stp/stp_util.c
+++ b/stp/stp_util.c
@@ -92,6 +92,9 @@ UINT32 stputil_get_path_cost(STP_PORT_SPEED port_speed, bool extend)
 		case STP_SPEED_40G:
 			return ((extend) ? STP_PORT_PATH_COST_40G : STP_LEGACY_PORT_PATH_COST_40G);
 			
+		case STP_SPEED_50G:
+			return ((extend) ? STP_PORT_PATH_COST_50G : STP_LEGACY_PORT_PATH_COST_50G);
+			
 		case STP_SPEED_100G:
 			return ((extend) ? STP_PORT_PATH_COST_100G: STP_LEGACY_PORT_PATH_COST_100G);
 		
-- 
2.25.1


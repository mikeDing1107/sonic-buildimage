From: joshjiang113 <josh_jiang@sdc.sercomm.com>
Date: Fri, 18 Sep 2026 08:58:57 +0000
Subject: [PATCH] support show temperature

---
 rd98dx45xx_cn9131/sonic_platform/chassis.py | 72 +++++++++++++++-
 rd98dx45xx_cn9131/sonic_platform/thermal.py | 91 +++++++++++++++++++++
 2 files changed, 162 insertions(+), 1 deletion(-)
 create mode 100644 rd98dx45xx_cn9131/sonic_platform/thermal.py

diff --git a/rd98dx45xx_cn9131/sonic_platform/chassis.py b/rd98dx45xx_cn9131/sonic_platform/chassis.py
index 184713f..4bc3d41 100644
--- a/rd98dx45xx_cn9131/sonic_platform/chassis.py
+++ b/rd98dx45xx_cn9131/sonic_platform/chassis.py
@@ -7,6 +7,8 @@ try:
     import os
     import sys
     import smbus
+    import glob
+    from .thermal import Thermal
     from sonic_platform_base.chassis_base import ChassisBase
     from sonic_platform.sfp import Sfp
     from sonic_platform.eeprom import Eeprom
@@ -77,6 +79,74 @@ class Chassis(ChassisBase):
         for i in range(MAX_COMPONENT):
             component = Component(i)
             self._component_list.append(component)
+            
+        self._thermal_list = self._discover_thermals()
+    
+    def _discover_thermals(self):
+        thermals = []
+        seen_types = set()
+        
+        for zone_path in sorted(glob.glob('/sys/class/thermal/thermal_zone*')):
+            zone_name = os.path.basename(zone_path)
+            type_file = os.path.join(zone_path, 'type')
+            temp_file = os.path.join(zone_path, 'temp')
+
+            if not os.path.exists(temp_file):
+                continue
+
+            try:
+                with open(type_file, 'r') as f:
+                    zone_type = f.read().strip()
+            except IOError:
+                zone_type = zone_name
+
+            if zone_type in seen_types:
+                continue
+            seen_types.add(zone_type)
+
+            thermals.append(Thermal(zone_type, zone_type, zone_path))
+            
+        for hwmon_path in sorted(glob.glob('/sys/class/hwmon/hwmon*')):
+            name_file = os.path.join(hwmon_path, 'name')
+            try:
+                with open(name_file, 'r') as f:
+                    hwmon_name = f.read().strip()
+            except IOError:
+                hwmon_name = os.path.basename(hwmon_path)
+
+            temp_inputs = sorted(glob.glob(os.path.join(hwmon_path, 'temp*_input')))
+            for temp_input in temp_inputs:
+                basename = os.path.basename(temp_input)
+                idx = basename.replace('_input', '').replace('temp', '')
+
+                label_file = os.path.join(hwmon_path, 'temp{}_label'.format(idx))
+                try:
+                    with open(label_file, 'r') as f:
+                        sensor_name = f.read().strip()
+                except IOError:
+                    sensor_name = '{} temp{}'.format(hwmon_name, idx)
+
+                if sensor_name in seen_types:
+                    continue
+                seen_types.add(sensor_name)
+
+                thermals.append(Thermal(sensor_name, hwmon_name, hwmon_path, thermal_index=int(idx)))
+
+        return thermals
+    
+    def get_all_thermals(self):
+        return self._thermal_list
+        
+    def get_num_thermals(self):
+        return len(self._thermal_list)
+    
+    def get_thermal(self, index):
+        try:
+            return self._thermal_list[index]
+        except IndexError:
+            sonic_logger.log_warning("Thermal index {} out of range (0-{})".format(
+                index, len(self._thermal_list) - 1))
+            return None
 
     def __del__(self):
         if self.bus:
@@ -231,4 +301,4 @@ class Chassis(ChassisBase):
         if status:
             return True, {'sfp': port_dict}
         else:
-            return True, {'sfp': {}}
+            return True, {'sfp': {}} 
diff --git a/rd98dx45xx_cn9131/sonic_platform/thermal.py b/rd98dx45xx_cn9131/sonic_platform/thermal.py
new file mode 100644
index 0000000..837a78e
--- /dev/null
+++ b/rd98dx45xx_cn9131/sonic_platform/thermal.py
@@ -0,0 +1,91 @@
+import os
+from sonic_platform_base.thermal_base import ThermalBase
+
+class Thermal(ThermalBase):
+    """Platform-specific thermal sensor implementation."""
+
+    def __init__(self, name, thermal_type, path_prefix, thermal_index=0):
+        self._name = name
+        self._type = thermal_type
+        self._path_prefix = path_prefix
+        self._thermal_index = thermal_index
+
+    def get_name(self):
+        return self._name
+
+    def get_position_in_parent(self):
+        return self._thermal_index
+
+    def get_presence(self):
+        return os.path.exists(self._path_prefix)
+
+    def get_status(self):
+        return self.get_presence()
+
+    def get_model(self):
+        return ""
+
+    def get_serial(self):
+        return ""
+
+    def is_replaceable(self):
+        return False
+
+    def get_minimum_recorded(self):
+        return None
+
+    def get_maximum_recorded(self):
+        return None
+
+    def get_temperature(self):
+        if self._thermal_index:
+            temp_file = os.path.join(
+                self._path_prefix, 
+                'temp{}_input'.format(self._thermal_index)
+            )
+        else:
+            temp_file = os.path.join(self._path_prefix, 'temp')
+
+        try:
+            with open(temp_file, 'r') as f:
+                raw = f.read().strip()
+            return int(raw) / 1000.0
+        except (IOError, ValueError):
+            return None
+
+    def get_high_threshold(self):
+        trip_file = os.path.join(self._path_prefix, 'trip_point_0_temp')
+        if os.path.exists(trip_file):
+            try:
+                with open(trip_file, 'r') as f:
+                    return int(f.read().strip()) / 1000.0
+            except (IOError, ValueError):
+                pass
+        return None
+
+    def get_high_critical_threshold(self):
+        trip_file = os.path.join(self._path_prefix, 'trip_point_1_temp')
+        if os.path.exists(trip_file):
+            try:
+                with open(trip_file, 'r') as f:
+                    return int(f.read().strip()) / 1000.0
+            except (IOError, ValueError):
+                pass
+        return self.get_high_threshold()
+
+    def get_low_threshold(self):
+        return None
+
+    def get_low_critical_threshold(self):
+        return None
+
+    def get_temperature_thresholds(self):
+        return self.get_high_threshold(), self.get_low_threshold()
+
+    @property
+    def name(self):
+        return self._name
+    
+    @property
+    def type(self):
+        return self._type

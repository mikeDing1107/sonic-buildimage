From 1a564478b622644770c0fc0ec55dd2952d76f887 Mon Sep 17 00:00:00 2001
From: mike_ding <mike_ding@sdc.sercomm.com>
Date: Tue, 20 Oct 2026 14:12:00 +0800
Subject: [PATCH] fix procdockerstatsd crash when process exits during
 enumeration

Guard psutil.process_iter() and the sort key against NoSuchProcess so the daemon stops crashing (~1/hour under normal churn, minutes under heavy churn). Reproduced on kaitian board with process churn before the fix; no crash after.
---
 scripts/procdockerstatsd | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/scripts/procdockerstatsd b/scripts/procdockerstatsd
index c0600fd..d8abfe3 100755
--- a/scripts/procdockerstatsd
+++ b/scripts/procdockerstatsd
@@ -141,9 +141,18 @@ class ProcDockerStats(daemon_base.DaemonBase):
         pid_set = set()
 
         processes_all = []
-        for process_obj in psutil.process_iter(['pid', 'ppid', 'memory_percent', 'cpu_percent', 'create_time', 'cmdline']):
-            processes_all.append(process_obj)
-        sorted_processes = sorted(processes_all, key=lambda x: x.cpu_percent(), reverse=True)
+        try:
+            for process_obj in psutil.process_iter(['pid', 'ppid', 'memory_percent', 'cpu_percent', 'create_time', 'cmdline']):
+                processes_all.append(process_obj)
+        except (psutil.NoSuchProcess, psutil.AccessDenied):
+            pass
+
+        def _cpu_key(p):
+            try:
+                return p.cpu_percent()
+            except (psutil.NoSuchProcess, psutil.AccessDenied):
+                return 0.0
+        sorted_processes = sorted(processes_all, key=_cpu_key, reverse=True)
         top_processes = sorted_processes[:1024]
 
         for process_obj in top_processes:
-- 

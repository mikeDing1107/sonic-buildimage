diff --git a/sonic_installer/main.py b/sonic_installer/main.py
index 6a445504..9247a409 100644
--- a/sonic_installer/main.py
+++ b/sonic_installer/main.py
@@ -543,6 +543,8 @@ def install(url, force, skip_platform_check=False, skip_migration=False, skip_pa

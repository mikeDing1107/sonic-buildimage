--- /dev/null
+++ b/gnmi_server/gnoi_led.go
@@ -0,0 +1,44 @@
+package gnmi
+
+import (
+	"context"
+	"fmt"
+
+	log "github.com/golang/glog"
+	pb "github.com/sonic-net/sonic-gnmi/proto/gnoi/led"
+	ssc "github.com/sonic-net/sonic-gnmi/sonic_service_client"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	json "google.golang.org/protobuf/encoding/protojson"
+)
+
+// Flash implements the corresponding RPC.
+func (srv *Server) Flash(ctx context.Context, req *pb.FlashRequest) (*pb.FlashResponse, error) {
+	ctx, err := authenticate(srv.config, ctx, "gnoi", false)
+	if err != nil {
+		return nil, err
+	}
+	log.V(1).Infof("gNOI: led_control.Flash led_id=%d color=%s mode=%s", req.LedId, req.Color, req.Mode)
+
+	reqStr, err := json.Marshal(req)
+	if err != nil {
+		return nil, status.Errorf(codes.Internal, fmt.Sprintf("Cannot marshal FlashRequest: [%s], err %v", req.String(), err))
+	}
+
+	sc, err := ssc.NewDbusClient()
+	if err != nil {
+		return nil, status.Errorf(codes.Internal, fmt.Sprintf("Error creating dbus client: [%s]", err.Error()))
+	}
+
+	respStr, err := sc.LedFlash(string(reqStr))
+	log.V(1).Infof("gNOI: led_control.Flash Response %s", respStr)
+	if err != nil {
+		return nil, status.Errorf(codes.Internal, fmt.Sprintf("Backend error: %v", err))
+	}
+
+	resp := &pb.FlashResponse{}
+	if err := json.Unmarshal([]byte(respStr), resp); err != nil {
+		return nil, status.Errorf(codes.Internal, fmt.Sprintf("Cannot unmarshal backend response: [%s], error: %v", respStr, err))
+	}
+	return resp, nil
+}
diff --git a/gnmi_server/gnoi_led_test.go b/gnmi_server/gnoi_led_test.go
new file mode 100644
index 0000000..bdc55a4
--- /dev/null
+++ b/gnmi_server/gnoi_led_test.go
@@ -0,0 +1,80 @@
+package gnmi
+
+import (
+	"context"
+	"crypto/tls"
+	"fmt"
+	"testing"
+
+	"github.com/agiledragon/gomonkey/v2"
+	led_pb "github.com/sonic-net/sonic-gnmi/proto/gnoi/led"
+	ssc "github.com/sonic-net/sonic-gnmi/sonic_service_client"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials"
+	"google.golang.org/grpc/status"
+)
+
+const (
+	ledFlashSuccess string = `{"success": true, "message": "accepted"}`
+	ledFlashFail    string = `{"success": false, "message": "Invalid color: 'purple', allowed: [blue green red yellow]"}`
+)
+
+func TestGnoiLedFlash(t *testing.T) {
+	s := createServer(t, 8082)
+	go runServer(t, s)
+	defer s.Stop()
+
+	tlsConfig := &tls.Config{InsecureSkipVerify: true}
+	opts := []grpc.DialOption{grpc.WithTransportCredentials(credentials.NewTLS(tlsConfig))}
+	conn, err := grpc.Dial("127.0.0.1:8082", opts...)
+	if err != nil {
+		t.Fatalf("Dialing failed: %v", err)
+	}
+	defer conn.Close()
+	c := led_pb.NewLedControlClient(conn)
+
+	t.Run("Successful Flash", func(t *testing.T) {
+		patch1 := gomonkey.ApplyFuncReturn(ssc.NewDbusClient, &ssc.DbusClient{}, nil)
+		patch2 := gomonkey.ApplyFuncReturn(ssc.DbusApi, ledFlashSuccess, nil)
+		defer patch1.Reset()
+		defer patch2.Reset()
+
+		resp, err := c.Flash(context.Background(), &led_pb.FlashRequest{LedId: 1, Color: "green", Mode: "flash"})
+		if err != nil {
+			t.Fatalf("Unexpected error %v", err)
+		}
+		if !resp.Success {
+			t.Fatalf("Expected success but got: %s", resp.Message)
+		}
+	})
+
+	t.Run("DBus Client Error", func(t *testing.T) {
+		patch := gomonkey.ApplyFuncReturn(ssc.NewDbusClient, nil, fmt.Errorf("client error"))
+		defer patch.Reset()
+
+		_, err := c.Flash(context.Background(), &led_pb.FlashRequest{LedId: 1, Color: "red", Mode: "stable"})
+		if err == nil {
+			t.Fatalf("Expected error but got success")
+		}
+		if status.Code(err) != codes.Internal {
+			t.Fatalf("Expected Internal error but got %#v", status.Code(err))
+		}
+	})
+
+	t.Run("Backend Validation Error", func(t *testing.T) {
+		patch1 := gomonkey.ApplyFuncReturn(ssc.NewDbusClient, &ssc.DbusClient{}, nil)
+		patch2 := gomonkey.ApplyFuncReturn(ssc.DbusApi, ledFlashFail, nil)
+		defer patch1.Reset()
+		defer patch2.Reset()
+
+		resp, err := c.Flash(context.Background(), &led_pb.FlashRequest{LedId: 1, Color: "purple", Mode: "flash"})
+		if err != nil {
+			t.Fatalf("Unexpected error %v", err)
+		}
+		if resp.Success {
+			t.Fatalf("Expected failure but got success")
+		}
+	})
+}

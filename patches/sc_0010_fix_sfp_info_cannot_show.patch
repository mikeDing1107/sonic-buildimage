+    def read_eeprom_bytes(self, offset, size):
+        """ Override the new xcvr architecture's EEPROM read method.
+        This intercepts the base class's read requests and maps them to our I2C MUX logic.
+        Crucially, it maps offset >= 256 to EEPROM address 0x51 (A2h).
+        """
+        with i2c_lock:
+            if not self._switch_mux():
+                return None
+            try:
+                result = bytearray()
+                bytes_remaining = size
+                current_offset = offset
+                MAX_BLOCK_SIZE = 32
+
+                while bytes_remaining > 0:
+                    # Determine target address (0x50 or 0x51)
+                    is_a2h = (current_offset >= 256)
+                    read_addr = 0x51 if is_a2h else 0x50
+                    read_offset = current_offset - 256 if is_a2h else current_offset
+
+                    # Fix: Ensure chunk does not cross the 256 boundary
+                    if not is_a2h:
+                        # If reading from A0h, max chunk is distance to 256
+                        max_chunk_before_boundary = 256 - current_offset
+                        chunk_size = min(bytes_remaining, MAX_BLOCK_SIZE, max_chunk_before_boundary)
+                    else:
+                        chunk_size = min(bytes_remaining, MAX_BLOCK_SIZE)
+
+                    data = self.bus.read_i2c_block_data(read_addr, read_offset, chunk_size)
+                    result.extend(data)

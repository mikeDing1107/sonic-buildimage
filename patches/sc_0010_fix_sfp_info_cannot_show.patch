+    def _switch_mux(self):
+        """Switch MUX to the channel corresponding to the current port before reading."""
+        mux_val = self.mux_map.get(self.index)
+        if self.bus and mux_val is not None:
+            try:
+                self.bus.write_byte_data(self.mux_addr, self.mux_reg, mux_val)
+                return True
+            except Exception as e:
+                logger.log_error("Failed to switch MUX for port {}: {}".format(self.index, e))
+                return False
+        return False
+
+    def read_eeprom(self, offset, num_bytes, addr=0x50):
+        """
+        Safely read EEPROM bytes in chunks of max 32 bytes.
+        Added 'addr' parameter to support reading from 0x51.
+        """
+        if not self._switch_mux():
+            return None
         
+        try:
+            result = bytearray()
+            bytes_remaining = num_bytes
+            current_offset = offset
+            
+            # Linux I2C subsystem limits block reads to 32 bytes max
+            MAX_BLOCK_SIZE = 32 
+            
+            while bytes_remaining > 0:
+                chunk_size = min(bytes_remaining, MAX_BLOCK_SIZE)
+                data = self.bus.read_i2c_block_data(addr, current_offset, chunk_size)
+                result.extend(data)
+                
+                current_offset += chunk_size
+                bytes_remaining -= chunk_size
+                
+            return bytes(result)
+            
+        except IOError:
+            # IOError usually means no module is present on this channel
+            return None
+        except Exception as e:
+            logger.log_error("Failed to read EEPROM for port {}: {}".format(self.index, e))
+            return None
+
+    def read_eeprom_bytes(self, offset, size):
+        """
+        Override the new xcvr architecture's EEPROM read method.
+        This intercepts the base class's read requests and maps them to our I2C MUX logic.
+        Crucially, it maps offset >= 256 to EEPROM address 0x51 (A2h).
+        """
+        if not self._switch_mux():
+            return None
+
+        try:
+            result = bytearray()
+            bytes_remaining = size
+            current_offset = offset
+            MAX_BLOCK_SIZE = 32
+
+            while bytes_remaining > 0:
+                chunk_size = min(bytes_remaining, MAX_BLOCK_SIZE)
+
+                # Core logic: If offset >= 256, read from 0x51, otherwise 0x50
+                read_addr = 0x51 if current_offset >= 256 else 0x50
+                read_offset = current_offset - 256 if current_offset >= 256 else current_offset
+
+                data = self.bus.read_i2c_block_data(read_addr, read_offset, chunk_size)
+                result.extend(data)
+
+                current_offset += chunk_size
+                bytes_remaining -= chunk_size
+
+            return bytes(result)
+
+        except IOError:
+            return None
+        except Exception as e:
+            logger.log_error("Failed to read EEPROM bytes for port {}: {}".format(self.index, e))
+            return None
+

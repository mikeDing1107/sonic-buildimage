+    def read_eeprom(self, offset, num_bytes, addr=0x50):
+        """ Safely read EEPROM bytes in chunks of max 32 bytes. """
+        with i2c_lock:
+            if not self._switch_mux():
+                return None
+            try:
+                result = bytearray()
+                bytes_remaining = num_bytes
+                current_offset = offset
+                MAX_BLOCK_SIZE = 32

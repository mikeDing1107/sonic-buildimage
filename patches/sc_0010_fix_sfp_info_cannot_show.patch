+# sonic_platform/mux_map.py
+
+# Mapping based on 'show interface status' Lanes column
+# Key: Physical Lane Index (0-28)
+# Value: MUX Channel Value
+PORT_MUX_MAP = {
+    28: 0x1D, # Ethernet1 -> fiftyGigE28
+    26: 0x1B, # Ethernet2 -> fiftyGigE26
+    27: 0x1C, # Ethernet3 -> fiftyGigE27
+    24: 0x19, # Ethernet4 -> fiftyGigE24
+    25: 0x1A, # Ethernet5 -> fiftyGigE25
+    17: 0x01, # Ethernet6 -> twenty5GigE17
+    16: 0x02, # Ethernet7 -> twenty5GigE16
+    19: 0x03, # Ethernet8 -> twenty5GigE19
+    18: 0x04, # Ethernet9 -> twenty5GigE18
+    21: 0x05, # Ethernet10 -> twenty5GigE21
+    20: 0x06, # Ethernet11 -> twenty5GigE20
+    23: 0x07, # Ethernet12 -> twenty5GigE23
+    22: 0x08, # Ethernet13 -> twenty5GigE22
+    9: 0x09,  # Ethernet14 -> twenty5GigE9
+    8: 0x0A,  # Ethernet15 -> twenty5GigE8
+    11: 0x0B, # Ethernet16 -> twenty5GigE11
+    10: 0x0C, # Ethernet17 -> twenty5GigE10
+    13: 0x0D, # Ethernet18 -> twenty5GigE13
+    12: 0x0E, # Ethernet19 -> twenty5GigE12
+    15: 0x0F, # Ethernet20 -> twenty5GigE15
+    14: 0x10, # Ethernet21 -> twenty5GigE14
+    6: 0x11,  # Ethernet22 -> twenty5GigE6
+    7: 0x12,  # Ethernet23 -> twenty5GigE7
+    4: 0x13,  # Ethernet24 -> twenty5GigE4
+    5: 0x14,  # Ethernet25 -> twenty5GigE5
+    2: 0x15,  # Ethernet26 -> twenty5GigE2
+    3: 0x16,  # Ethernet27 -> twenty5GigE3
+    0: 0x17,  # Ethernet28 -> twenty5GigE0 (Note: Lane 0!)
+    1: 0x18   # Ethernet29 -> twenty5GigE1
+}

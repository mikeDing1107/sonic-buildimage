From 805537b6d101054c664d4a13fd5fee11e5aa3fdf Mon Sep 17 00:00:00 2001
From: joshjiang113 <josh_jiang@sdc.sercomm.com>
Date: Wed, 14 Oct 2026 07:13:21 +0000
Subject: [PATCH] fix show system-health cli is not working

---
 rd98dx45xx_cn9131/sonic_platform/chassis.py | 40 +++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/rd98dx45xx_cn9131/sonic_platform/chassis.py b/rd98dx45xx_cn9131/sonic_platform/chassis.py
index 36a284a..8039b3a 100644
--- a/rd98dx45xx_cn9131/sonic_platform/chassis.py
+++ b/rd98dx45xx_cn9131/sonic_platform/chassis.py
@@ -153,6 +153,14 @@ class Chassis(ChassisBase):
     """ Platform-specific Chassis class derived from Dell S6000 platform.
     customized for the platform.
     """
+    _LED1_PWM_REGS = {
+        'red':   0x0E,
+        'green': 0x0F,
+        'blue':  0x10,
+    }
+    _I2C_BUS = 3
+    _I2C_ADDR = 0x17
+    
     reset_reason_dict = {}
     reset_reason_dict[0x02] = ChassisBase.REBOOT_CAUSE_POWER_LOSS
     reset_reason_dict[0x20] = ChassisBase.REBOOT_CAUSE_THERMAL_OVERLOAD_ASIC
@@ -287,6 +295,38 @@ class Chassis(ChassisBase):
 
     def __is_host(self):
         return os.system(self.HOST_CHK_CMD) == 0
+    
+    def initizalize_system_led(self):
+        return True
+        
+    def _read_i2c_byte(self, reg):
+        try:
+            cmd = ['i2cget', '-y', str(self._I2C_BUS), hex(self._I2C_ADDR), hex(reg)]
+            result = subprocess.run(cmd, capture_output=True, text=True, timeout=2)
+            if result.returncode == 0 and result.stdout.strip():
+                return int(result.stdout.strip(), 16)
+        except Exception:
+            pass
+        return None
+        
+    def get_status_led(self):
+        pwm = {}
+        for color, reg in self._LED1_PWM_REGS.items():
+            val = self._read_i2c_byte(reg)
+            if val is None:
+                return None
+            pwm[color] = (val == 0xFF)
+
+        if pwm['green'] and pwm['red']:
+            return 'amber'
+        elif pwm['green']:
+            return 'green'
+        elif pwm['red']:
+            return 'red'
+        elif pwm['blue']:
+            return 'blue'
+        else:
+            return 'off'
 
     def get_sfp(self, index):
         """ Retrieves sfp represented by (1-based) index <index>
-- 
2.25.1


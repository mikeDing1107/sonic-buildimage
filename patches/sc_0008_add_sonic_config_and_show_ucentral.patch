new file mode 100755
index 00000000..72144635
--- /dev/null
+++ b/show/ucentral.py
@@ -0,0 +1,28 @@
+import click
+import utilities_common.cli as clicommon
+from utilities_common.db import Db
+
+@click.group(cls=clicommon.AliasedGroup)
+def ucentral():
+    """Show uCentral Client related information"""
+    pass
+
+@ucentral.command()
+@click.pass_context
+def status(ctx):
+    """Show uCentral Client status"""
+    db = ctx.obj if ctx.obj else Db()
+    config_table = db.cfgdb.get_entry("UCENTRAL", "global")
+
+    if not config_table:
+        click.echo("uCentral Client is not configured.")
+        return
+
+    enable = config_table.get("enable", "false")
+    redirector_url = config_table.get("RedirectorURL", "N/A")
+    sn = config_table.get("SN", "N/A")
+
+    click.echo(f"{'Status':<15} {'RedirectorURL':<45} {'SN':<20}")
+    click.echo(f"{'-'*15} {'-'*45} {'-'*20}")
+    
+    click.echo(f"{enable:<15} {redirector_url:<45} {sn:<20}")
\ No newline at end of file

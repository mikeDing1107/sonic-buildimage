diff --git a/config/ucentral.py b/config/ucentral.py
new file mode 100755
index 00000000..80e0438d
--- /dev/null
+++ b/config/ucentral.py
@@ -0,0 +1,35 @@
+import click
+import utilities_common.cli as clicommon
+from utilities_common.db import Db
+
+@click.group(cls=clicommon.AliasedGroup)
+def ucentral():
+    """Configure uCentral Client"""
+    pass
+
+@ucentral.command()
+@click.argument("status", type=click.Choice(["true", "false"]))
+@click.option("--RedirectorURL", "-u", required=True, help="Redirector URL for the uCentral server")
+@click.option("--SN", "-s", required=True, help="Serial Number of the device")
+@click.pass_context
+def enable(ctx, status, redirectorurl, sn):
+    """Enable or disable uCentral Client"""
+    db = ctx.obj if ctx.obj else Db()
+    
+    db.cfgdb.mod_entry("UCENTRAL", "global", {
+        "enable": status,
+        "RedirectorURL": redirectorurl,
+        "SN": sn
+    })
+    
+    click.echo(f"uCentral Client configuration has been set:")
+    click.echo(f"  Status: {status}")
+    click.echo(f"  Redirector URL: {redirectorurl}")
+    click.echo(f"  Serial Number (SN): {sn}")
+
+    if status == "true":
+        click.echo("Starting ucentral-client service...")
+        clicommon.run_command(['systemctl', 'restart', 'ucentral-client'], display_cmd=True)
+    else:
+        click.echo("Stopping ucentral-client service...")
+        clicommon.run_command(['systemctl', 'stop', 'ucentral-client'], display_cmd=True)
\ No newline at end of file

From: joshjiang113 <josh_jiang@sdc.sercomm.com>
Date: Wed, 30 Sep 2026 01:55:30 +0000
Subject: [PATCH] add reset button led spec

---
 rd98dx45xx_cn9131/utils/rst_button.py | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/rd98dx45xx_cn9131/utils/rst_button.py b/rd98dx45xx_cn9131/utils/rst_button.py
index 051bf3a..6e91106 100755
--- a/rd98dx45xx_cn9131/utils/rst_button.py
+++ b/rd98dx45xx_cn9131/utils/rst_button.py
@@ -2,7 +2,7 @@ import subprocess
 import time
 import os
 
-GPIO_TOOL = "/etc/sercomm/sc_gpio"
+GPIO_TOOL = "/usr/local/bin/sc_gpio"
 GPIO_PIN = "36"
 
 REBOOT_MIN_TIME = 1
@@ -27,6 +27,7 @@ class RstButtonMonitor:
     def restore_default(self):
         print("Factory reset triggered. Restoring default config...", flush=True)
         
+        subprocess.run(["/usr/local/bin/sc_led", "1", "yellow", "flash"])
         subprocess.run(["rm", "-f", "/etc/sonic/config_db.json"])
         time.sleep(0.5)
         
@@ -77,4 +78,4 @@ class RstButtonMonitor:
 
 if __name__ == '__main__':
     monitor = RstButtonMonitor()
-    monitor.run()
\ No newline at end of file
+    monitor.run()

From 723fc10f2cf4d6bdb77cfd1dc66411b1ad96607e Mon Sep 17 00:00:00 2001
From: joshjiang113 <josh_jiang@sdc.sercomm.com>
Date: Fri, 18 Sep 2026 06:13:46 +0000
Subject: [PATCH] fix show temperature fail

---
 sonic-thermalctld/scripts/thermalctld | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/sonic-thermalctld/scripts/thermalctld b/sonic-thermalctld/scripts/thermalctld
index 67fcf05..0e83ffa 100644
--- a/sonic-thermalctld/scripts/thermalctld
+++ b/sonic-thermalctld/scripts/thermalctld
@@ -648,7 +648,13 @@ class TemperatureUpdater(logger.Logger):
                             available_thermals.add((thermal, psu_name, thermal_index))
                             self._refresh_temperature_status(psu_name, thermal, thermal_index)
 
-        thermals_to_remove = self.all_thermals - available_thermals
+        old_by_name = {(t[0].get_name(), t[1]) for t in self.all_thermals}
+        new_by_name = {(t[0].get_name(), t[1]) for t in available_thermals}
+        removed_names = old_by_name - new_by_name
+        thermals_to_remove = [
+            t for t in self.all_thermals
+            if (t[0].get_name(), t[1]) in removed_names
+        ]
         self.all_thermals = available_thermals
         for thermal, parent_name, thermal_index in thermals_to_remove:
             self._remove_thermal_from_db(thermal, parent_name, thermal_index)

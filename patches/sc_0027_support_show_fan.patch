From: joshjiang113 <josh_jiang@sdc.sercomm.com>
Date: Sun, 20 Sep 2026 06:44:24 +0000
Subject: [PATCH] support show platform fan

---
 rd98dx45xx_cn9131/sonic_platform/chassis.py | 146 +++++++++++++++++++-
 1 file changed, 144 insertions(+), 2 deletions(-)

diff --git a/rd98dx45xx_cn9131/sonic_platform/chassis.py b/rd98dx45xx_cn9131/sonic_platform/chassis.py
index 4bc3d41..d9e7496 100644
--- a/rd98dx45xx_cn9131/sonic_platform/chassis.py
+++ b/rd98dx45xx_cn9131/sonic_platform/chassis.py
@@ -14,8 +14,12 @@ try:
     from sonic_platform.eeprom import Eeprom
     from sonic_py_common import logger
     from sonic_platform.component import Component
+    from sonic_platform_base.fan_base import FanBase
+    from sonic_platform_base.fan_drawer_base import FanDrawerBase
     # Import shared MUX map
     from sonic_platform.mux_map import PORT_MUX_MAP
+    import subprocess
+    import re
 except ImportError as e:
     raise ImportError(str(e) + "- required module not found")
 
@@ -30,6 +34,130 @@ MAX_COMPONENT=2
 SYSLOG_IDENTIFIER = "chassis"
 sonic_logger = logger.Logger(SYSLOG_IDENTIFIER)
 
+# Fan configuration
+FAN_SCRIPT_PATH = '/etc/sercomm/fan'
+NUM_FANS = 3
+
+class Fan(FanBase): 
+    """Fan class for Sercomm platform."""
+
+    def __init__(self, fan_index):
+        super().__init__()
+        self.fan_index = fan_index
+        self.fan_id = fan_index + 1
+
+    def get_speed(self):
+        """Get fan speed percentage by calling /etc/sercomm/fan script."""
+        try:
+            result = subprocess.run(
+                [FAN_SCRIPT_PATH],
+                capture_output=True,
+                text=True,
+                timeout=5
+            )
+            output = result.stdout
+            pattern = r'fan\s+(\d+)\s+speed\s+is\s+(\d+)\s*%'
+            for line in output.splitlines():
+                match = re.match(pattern, line)
+                if match:
+                    fid = int(match.group(1))
+                    speed = int(match.group(2))
+                    if fid == self.fan_id:
+                        return speed
+        except Exception as e:
+            sonic_logger.log_error("Failed to get fan {} speed: {}".format(self.fan_id, str(e)))
+        return 0
+
+    def get_target_speed(self):
+        """Get target fan speed - return current speed as target."""
+        return self.get_speed()
+
+    def get_presence(self):
+        """Check if fan is present."""
+        return True
+
+    def get_direction(self):
+        """Get fan direction."""
+        return "front_to_back"
+
+    def get_status(self):
+        """Get fan status - True means OK."""
+        return True
+
+    def is_under_speed(self):
+        """Check if fan is under speed."""
+        return False
+
+    def is_over_speed(self):
+        """Check if fan is over speed."""
+        return False
+
+    def get_model(self):
+        """Get fan model."""
+        return None
+
+    def get_serial(self):
+        """Get fan serial number."""
+        return None
+
+    def is_replaceable(self):
+        """Check if fan is replaceable."""
+        return True
+
+    def get_name(self):
+        """Get fan name."""
+        return "fan{}".format(self.fan_id)
+    
+    def get_position_in_parent(self):
+        return self.fan_index
+        
+    def is_replaceable(self):
+        return True
+
+
+class FanDrawer(FanDrawerBase):
+    """Fan drawer class for Sercomm platform."""
+
+    def __init__(self, drawer_index):
+        super().__init__()  
+        self.drawer_index = drawer_index
+        self._fans = []
+        for i in range(NUM_FANS):
+            self._fans.append(Fan(i))
+
+    def get_all_fans(self):
+        """Get all fans in this drawer."""
+        return self._fans
+
+    def get_presence(self):
+        """Check if fan drawer is present."""
+        return True
+
+    def get_status(self):
+        """Get fan drawer status."""
+        return True
+
+    def get_model(self):
+        """Get fan drawer model."""
+        return None
+
+    def get_serial(self):
+        """Get fan drawer serial number."""
+        return None
+
+    def get_name(self):
+        """Get fan drawer name."""
+        return "fan_drawer0"
+    
+    def get_position_in_parent(self):
+        return self.drawer_index
+        
+    def is_replaceable(self): 
+        return False
+        
+    def get_num_fans(self):
+        return len(self._fans)
+
 class Chassis(ChassisBase):
     """ Platform-specific Chassis class derived from Dell S6000 platform.
     customized for the platform.
@@ -79,7 +207,10 @@ class Chassis(ChassisBase):
         for i in range(MAX_COMPONENT):
             component = Component(i)
             self._component_list.append(component)
-            
+        
+		# Initialize fan drawers
+        self._fan_drawers = [FanDrawer(0)] 
+		
         self._thermal_list = self._discover_thermals()
     
     def _discover_thermals(self):
@@ -301,4 +432,15 @@ class Chassis(ChassisBase):
         if status:
             return True, {'sfp': port_dict}
         else:
-            return True, {'sfp': {}} 
+            return True, {'sfp': {}}
+            
+    def get_all_fan_drawers(self):
+        """Return a list of all fan drawers on the chassis."""
+        return self._fan_drawers
+
+    def get_all_fans(self):
+        """Return a list of all Fan objects on the chassis."""
+        fans = []
+        for drawer in self._fan_drawers:
+            fans.extend(drawer.get_all_fans())
+        return fans
-- 

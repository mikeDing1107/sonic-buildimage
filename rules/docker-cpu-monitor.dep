DPATH       := $($(DOCKER_CPU_MONITOR)_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/docker-cpu-monitor.mk rules/docker-cpu-monitor.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(DPATH))

$(DOCKER_CPU_MONITOR)_CACHE_MODE  := GIT_CONTENT_SHA
$(DOCKER_CPU_MONITOR)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(DOCKER_CPU_MONITOR)_DEP_FILES   := $(DEP_FILES)

$(eval $(call add_dbg_docker,$(DOCKER_CPU_MONITOR),$(DOCKER_CPU_MONITOR_DBG)))

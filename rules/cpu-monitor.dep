# rules/cpu-monitor.dep

SPATH       := $($(CPU_MONITOR)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/cpu-monitor.mk rules/cpu-monitor.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(SPATH))

$(CPU_MONITOR)_CACHE_MODE  := GIT_CONTENT_SHA
$(CPU_MONITOR)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(CPU_MONITOR)_DEP_FILES   := $(DEP_FILES)
